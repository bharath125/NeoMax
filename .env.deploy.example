# Read by scripts/deploy-frontend.sh. Copy to .env.deploy (git-ignored) and fill in.

# The private S3 bucket that holds the website. Must NOT be the bucket your generated videos go to.
SITE_BUCKET=neomax-web-prod

# The CloudFront distribution in front of that bucket (find it in the CloudFront console, e.g. E1ABCDEF234567).
CLOUDFRONT_DISTRIBUTION_ID=

# Optional: printed when the deploy finishes.
SITE_URL=https://app.example.com

# Optional AWS settings. Prefer a named profile with only the permissions this script needs.
# AWS_PROFILE=neomax-deploy
# AWS_REGION=ap-south-1
