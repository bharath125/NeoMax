PORT=4000
FRONTEND_URL=http://localhost:5173

MONGO_URI=mongodb://localhost:27017/viewmax

JWT_SECRET=change-me
JWT_EXPIRES_IN=7d

REDIS_URL=redis://localhost:6379

VIDEO_PROVIDER=kling
KLING_API_KEY=
KLING_API_BASE_URL=https://api.klingai.com

# VIDEO_PROVIDER=openrouter to use OpenRouter's video API instead of Kling
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_VIDEO_MODEL=heygen/heygen-video-1
# Text-to-image: a free model (50 requests/day per OpenRouter account; 1000/day after buying $10+ credits)
OPENROUTER_IMAGE_MODEL=recraft/recraft-v4.1-flash-v2:free
IMAGE_DAILY_LIMIT_PER_USER=10
IMAGE_CREDIT_COST=0

# Google sign-in: OAuth 2.0 Web client ID from Google Cloud Console (leave empty to hide the button)
GOOGLE_CLIENT_ID=

CREDIT_COST_PER_SECOND=8
# Cost per second when the user attaches reference images (served by OPENROUTER_REFERENCE_MODEL)
CREDIT_COST_PER_SECOND_REFERENCE=22
OPENROUTER_REFERENCE_MODEL=alibaba/wan-3.0
UPLOAD_DAILY_LIMIT_PER_USER=60
# Extend scene: max clips per scene, and ffmpeg/ffprobe binaries (needed on the API and worker hosts)
MAX_SCENE_PARTS=10
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe

# AWS S3: leave S3_ENDPOINT and S3_PUBLIC_BASE_URL empty, set a real region (e.g. ap-south-1); the bucket stays
# private and videos are served via presigned URLs. Cloudflare R2: set S3_ENDPOINT and S3_REGION=auto.
S3_ENDPOINT=
S3_REGION=ap-south-1
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BUCKET=viewmax-videos
S3_PUBLIC_BASE_URL=

# Payments (Razorpay). Use rzp_test_ keys while developing. The webhook secret is the one you set when creating
# the webhook in the Razorpay dashboard (URL: <api>/api/billing/webhook, events: order.paid, payment.captured).
PAYMENT_PROVIDER=razorpay
BILLING_CURRENCY=INR
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
