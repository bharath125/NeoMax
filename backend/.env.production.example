# Copy to backend/.env.production on the server (docker-compose.yml loads it). NEVER commit the real file.
# On AWS, attach an IAM role to the instance and leave the S3_ACCESS_KEY_* values empty: the SDK uses the role.

PORT=4000
# The public site that calls this API, used for CORS. With CloudFront routing /api/* here, this is the site's URL.
FRONTEND_URL=https://app.example.com

# MongoDB Atlas connection string (allow this server's IP in Atlas > Network Access).
MONGO_URI=mongodb+srv://USER:PASSWORD@cluster.mongodb.net/neomax?retryWrites=true&w=majority

# Generate with:  openssl rand -base64 48
JWT_SECRET=
JWT_EXPIRES_IN=7d

# Overridden to the bundled Redis container by docker-compose.yml.
REDIS_URL=redis://redis:6379

VIDEO_PROVIDER=openrouter
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_VIDEO_MODEL=heygen/heygen-video-1
OPENROUTER_REFERENCE_MODEL=alibaba/wan-3.0
OPENROUTER_IMAGE_MODEL=recraft/recraft-v4.1-flash-v2:free

CREDIT_COST_PER_SECOND=8
CREDIT_COST_PER_SECOND_REFERENCE=22
IMAGE_DAILY_LIMIT_PER_USER=10
IMAGE_CREDIT_COST=0
UPLOAD_DAILY_LIMIT_PER_USER=60
MAX_SCENE_PARTS=10

# Leave the keys empty when an IAM role is attached to the instance.
S3_REGION=ap-south-1
S3_BUCKET=
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_BASE_URL=

GOOGLE_CLIENT_ID=

PAYMENT_PROVIDER=razorpay
BILLING_CURRENCY=INR
# Use the live keys (rzp_live_...) only once Razorpay has approved your account.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
